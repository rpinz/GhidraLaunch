<?include $(var.VersionsFile) ?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal">
  <Bundle Name="Ghidra Launch" Manufacturer="rpinz" Version="$(var.ReleaseVersion)"
          Copyright="The Unlicense" DisableModify="yes" DisableRemove="yes"
          UpgradeCode="{9325B8EC-A307-482D-9072-A5C9EE1D172A}"
          Condition="VersionNT &gt;= v6.3 AND VersionNT64 &gt;= v6.3">
    <BootstrapperApplication>
      <bal:WixStandardBootstrapperApplication Theme="hyperlinkLicense"
          LicenseUrl="https://unlicense.org/" SuppressRepair="yes" />
    </BootstrapperApplication>
    <Chain>
      <MsiPackage Id="Temurin" DisplayName="Java runtime (Eclipse Temurin)"
                  SourceFile="$(var.PayloadRoot)\OpenJDK$(var.JavaVersion)U-jdk_x64.msi"
                  Compressed="no" DownloadUrl="$(var.JavaDownloadUrl)"
                  Permanent="yes" Visible="yes" Vital="yes" />
    </Chain>
  </Bundle>
</Wix>
