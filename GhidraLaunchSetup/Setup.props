<Project>
  <PropertyGroup>
    <OutputType>Bundle</OutputType>
    <Stage Condition="'$(Stage)' == ''">Setup</Stage>
    <OutputName>GhidraLaunch$(Stage)$(Variant)</OutputName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <InstallerPlatform>x86</InstallerPlatform>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <IntermediateOutputPath>obj\$(Stage)$(Variant)\$(Configuration)\</IntermediateOutputPath>
    <ReleaseVersion Condition="'$(ReleaseVersion)' == ''">0.0.0</ReleaseVersion>
    <SourceRoot>$(MSBuildThisFileDirectory)..\</SourceRoot>
    <PayloadRoot Condition="'$(PayloadRoot)' == ''">$(SourceRoot)</PayloadRoot>
    <VersionsFile Condition="'$(VersionsFile)' == ''">$(MSBuildThisFileDirectory)Versions.wxi</VersionsFile>
    <HelperPath Condition="'$(Variant)' == 'C'">$(SourceRoot)GhidraLaunchGhidraHelperC\x64\$(Configuration)\bin\GhidraLaunchGhidraHelperC.exe</HelperPath>
    <HelperPath Condition="'$(Variant)' == 'Rust'">$(SourceRoot)GhidraLaunchGhidraHelperRS\bin\$(Configuration)\GhidraLaunchGhidraHelperRS.exe</HelperPath>
    <MsiPath>$(SourceRoot)GhidraLaunchInstaller\bin\$(Configuration)\GhidraLaunchInstaller$(Variant).msi</MsiPath>
    <CorePath>$(MSBuildThisFileDirectory)bin\$(Configuration)\GhidraLaunchCore$(Variant).exe</CorePath>
    <JavaPath>$(MSBuildThisFileDirectory)bin\$(Configuration)\GhidraLaunchJava.exe</JavaPath>
    <DefineConstants>$(DefineConstants);Variant=$(Variant);ReleaseVersion=$(ReleaseVersion);HelperPath=$(HelperPath);MsiPath=$(MsiPath);CorePath=$(CorePath);JavaPath=$(JavaPath);PayloadRoot=$(PayloadRoot);VersionsFile=$(VersionsFile)</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Remove="$(BaseIntermediateOutputPath)**/*.wxl" />
    <PackageReference Include="WixToolset.Bal.wixext" Version="5.0.2" />
    <PackageReference Include="WixToolset.Util.wixext" Version="5.0.2" />
    <Compile Include="Bundle.wxs" Condition="'$(Stage)' == 'Setup'" />
    <Compile Include="Core.wxs" Condition="'$(Stage)' == 'Core'" />
    <Compile Include="Java.wxs" Condition="'$(Stage)' == 'Java'" />
    <ProjectReference Include="GhidraLaunchCore$(Variant).wixproj" Condition="'$(Stage)' == 'Setup'" SetPlatform="Platform=x86" />
    <ProjectReference Include="GhidraLaunchJava.wixproj" Condition="'$(Stage)' == 'Setup'" SetPlatform="Platform=x86" />
    <ProjectReference Include="..\GhidraLaunchInstaller\GhidraLaunchInstaller$(Variant).wixproj" Condition="'$(Stage)' == 'Core'" SetPlatform="Platform=x86" />
    <ProjectReference Include="..\GhidraLaunchGhidraHelperC\GhidraLaunchGhidraHelperC.vcxproj" Condition="'$(Stage)' == 'Core' and '$(Variant)' == 'C'" SetPlatform="Platform=x64" />
    <ProjectReference Include="..\GhidraLaunchGhidraHelperRS\GhidraLaunchGhidraHelperRS.vcxproj" Condition="'$(Stage)' == 'Core' and '$(Variant)' == 'Rust'" SetPlatform="Platform=x64" />
  </ItemGroup>
</Project>
