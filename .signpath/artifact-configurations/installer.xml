<?xml version="1.0" encoding="utf-8"?>
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <msi-file path="GhidraLaunchInstaller.msi"
              subject="Ghidra Launch"
              author="rpinz">
      <pe-file-set product-name="Ghidra Launch"
                   product-version="${version}">
        <include path="GhidraLaunchC.exe" />
        <include path="GhidraLaunchRS.exe" />
        <for-each>
          <authenticode-verify />
        </for-each>
      </pe-file-set>
      <authenticode-sign />
    </msi-file>
  </zip-file>
</artifact-configuration>
