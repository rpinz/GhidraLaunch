#include <windows.h>
#include "../Resources/Version.h"

1 VERSIONINFO
 FILEVERSION GHIDRA_LAUNCH_FILEVERSION
 PRODUCTVERSION GHIDRA_LAUNCH_FILEVERSION
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "GhidraLaunch"
            VALUE "FileDescription", "Ghidra Launch native C ZIP extraction helper"
            VALUE "FileVersion", GHIDRA_LAUNCH_VERSION
            VALUE "InternalName", "GhidraLaunchGhidraHelperC"
            VALUE "OriginalFilename", "GhidraLaunchGhidraHelperC.exe"
            VALUE "ProductName", "Ghidra Launch"
            VALUE "ProductVersion", GHIDRA_LAUNCH_PRODUCT_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
