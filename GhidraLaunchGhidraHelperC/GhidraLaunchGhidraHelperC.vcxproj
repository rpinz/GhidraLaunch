<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64"><Configuration>Debug</Configuration><Platform>x64</Platform></ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64"><Configuration>Release</Configuration><Platform>x64</Platform></ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <VCProjectVersion>17.0</VCProjectVersion>
    <ProjectGuid>{B7EF270F-72D7-4802-BA1C-B4EC9B310E51}</ProjectGuid>
    <Keyword>Win32Proj</Keyword>
    <RootNamespace>GhidraLaunchGhidraHelperC</RootNamespace>
    <ProjectName>GhidraLaunchGhidraHelperC</ProjectName>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <PlatformToolset>v143</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
    <UseDebugLibraries Condition="'$(Configuration)'=='Debug'">true</UseDebugLibraries>
    <UseDebugLibraries Condition="'$(Configuration)'=='Release'">false</UseDebugLibraries>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <PropertyGroup>
    <OutDir>$(ProjectDir)x64\$(Configuration)\bin\</OutDir>
    <IntDir>$(ProjectDir)x64\$(Configuration)\obj\</IntDir>
    <TargetName>GhidraLaunchGhidraHelperC</TargetName>
    <!-- helper.rc embeds Resources\helper.manifest; a linker manifest would collide (CVT1100) -->
    <GenerateManifest>false</GenerateManifest>
  </PropertyGroup>
  <PropertyGroup Condition="'$(HelperFaultTests)' == 'true'">
    <IntDir>$(ProjectDir)x64\$(Configuration)\obj\Faults\</IntDir>
    <TargetName>GhidraLaunchGhidraHelperCFaults</TargetName>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>Level4</WarningLevel>
      <TreatWarningAsError>true</TreatWarningAsError>
      <SDLCheck>true</SDLCheck>
      <ConformanceMode>true</ConformanceMode>
      <CompileAs>CompileAsC</CompileAs>
      <LanguageStandard_C>stdc17</LanguageStandard_C>
      <PreprocessorDefinitions>UNICODE;_UNICODE;WIN32_LEAN_AND_MEAN;NOMINMAX;_WIN32_WINNT=0x0A00;WINVER=0x0A00;MINIZ_NO_STDIO;MINIZ_NO_TIME;MINIZ_NO_DEFLATE_APIS;MINIZ_NO_ZLIB_APIS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <RuntimeLibrary Condition="'$(Configuration)'=='Debug'">MultiThreadedDebug</RuntimeLibrary>
      <RuntimeLibrary Condition="'$(Configuration)'=='Release'">MultiThreaded</RuntimeLibrary>
      <Optimization Condition="'$(Configuration)'=='Debug'">Disabled</Optimization>
      <Optimization Condition="'$(Configuration)'=='Release'">MaxSpeed</Optimization>
      <DebugInformationFormat>ProgramDatabase</DebugInformationFormat>
      <BufferSecurityCheck>true</BufferSecurityCheck>
      <ControlFlowGuard>Guard</ControlFlowGuard>
      <!-- static analysis (/analyze); its warnings are errors under /WX -->
      <EnablePREfast>true</EnablePREfast>
      <!-- system (angle-bracket) headers are external: no warnings or analysis results from SDK annotations -->
      <TreatAngleIncludeAsExternal>true</TreatAngleIncludeAsExternal>
      <ExternalWarningLevel>TurnOffAllWarnings</ExternalWarningLevel>
      <DisableAnalyzeExternal>true</DisableAnalyzeExternal>
      <!-- UTF-8 source/execution charset; SHA-256 source checksums in the PDB -->
      <AdditionalOptions>/utf-8 /ZH:SHA_256 %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
    <Link>
      <SubSystem>Console</SubSystem>
      <AdditionalDependencies>bcrypt.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <CETCompat>true</CETCompat>
      <!-- load-time imports only from System32 -->
      <AdditionalOptions>/DEPENDENTLOADFLAG:0x800 %(AdditionalOptions)</AdditionalOptions>
    </Link>
  </ItemDefinitionGroup>
  <!-- reproducible output (no timestamps); incompatible with incremental linking, so Release only -->
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <LinkIncremental>false</LinkIncremental>
  </PropertyGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release'">
    <ClCompile>
      <AdditionalOptions>/Brepro %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
    <Link>
      <AdditionalOptions>/Brepro %(AdditionalOptions)</AdditionalOptions>
    </Link>
  </ItemDefinitionGroup>
  <!-- the fault-test driver uses unbounded CRT string calls on fixed test buffers -->
  <ItemDefinitionGroup Condition="'$(HelperFaultTests)' == 'true'">
    <ClCompile>
      <PreprocessorDefinitions>_CRT_SECURE_NO_WARNINGS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="main.c" Condition="'$(HelperFaultTests)' != 'true'" />
    <ClCompile Include="tests\faults.c" Condition="'$(HelperFaultTests)' == 'true'" />
    <!-- vendored, byte-pinned sources: compiled at /W3 without /analyze so /WX does not require editing them -->
    <ClCompile Include="vendor\miniz\miniz.c"><WarningLevel>Level3</WarningLevel><EnablePREfast>false</EnablePREfast></ClCompile>
    <ClCompile Include="vendor\miniz\miniz_zip.c"><WarningLevel>Level3</WarningLevel><EnablePREfast>false</EnablePREfast></ClCompile>
    <ClCompile Include="vendor\miniz\miniz_tinfl.c"><WarningLevel>Level3</WarningLevel><EnablePREfast>false</EnablePREfast></ClCompile>
    <ResourceCompile Include="helper.rc" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="vendor\miniz\miniz.h" />
    <ClInclude Include="vendor\miniz\miniz_common.h" />
    <ClInclude Include="vendor\miniz\miniz_export.h" />
    <ClInclude Include="vendor\miniz\miniz_zip.h" />
    <ClInclude Include="vendor\miniz\miniz_tinfl.h" />
    <ClInclude Include="vendor\miniz\miniz_tdef.h" />
    <None Include="vendor\miniz\LICENSE" />
    <None Include="vendor\miniz\SHA256SUMS" />
    <None Include="BUILDING.md" />
    <None Include="..\Resources\helper.manifest" />
    <None Include="vendor\miniz\PROVENANCE.md" />
    <None Include="tests\faults.c" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
